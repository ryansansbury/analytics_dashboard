  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "VITE_STATIC_DATA=true tsc -b && VITE_STATIC_DATA=true vite build",
